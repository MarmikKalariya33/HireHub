<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Job_Portal.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">

    <title>HireHub Admin</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet"
        type="text/css"
        href="<%= ResolveUrl("~/Assets/Admincss/site.css") %>" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <aside class="sidebar">

        <!-- LOGO -->
        <div class="logo">

            <img src="<%= ResolveUrl("~/Assets/images/logo.png") %>"
                 alt="HireHub Logo" />

            <span class="admin-panel-badge">
                ADMIN PANEL
            </span>

        </div>


        <!-- MENU -->
        <div class="menu">

            <!-- DASHBOARD -->
            <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Dashboard.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>

            </a>


            <!-- USERS -->
            <a href="<%= ResolveUrl("~/Admin/Users.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Users.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-people-fill"></i>
                <span>Users</span>

            </a>


            <!-- EMPLOYERS -->
            <a href="<%= ResolveUrl("~/Admin/Employers.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Employers.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-building"></i>
                <span>Employers</span>

            </a>


            <!-- JOBS -->
            <a href="<%= ResolveUrl("~/Admin/Jobs.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Jobs.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-briefcase"></i>
                <span>Jobs</span>

            </a>


            <!-- APPLICATIONS -->
            <a href="<%= ResolveUrl("~/Admin/Applications.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Applications.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-file-earmark-text"></i>
                <span>Applications</span>

            </a>


            <!-- COMPANIES -->
            <a href="<%= ResolveUrl("~/Admin/Companies.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Companies.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-buildings"></i>
                <span>Companies</span>

            </a>


            <!-- CATEGORIES -->
            <a href="<%= ResolveUrl("~/Admin/Categories.aspx") %>"
               class="<%= Request.Url.AbsolutePath.EndsWith("Categories.aspx",
               StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                <i class="bi bi-tags"></i>
                <span>Categories</span>

            </a>

        </div>


        <!-- LOGOUT -->
        <div class="logout-container">

            <asp:LinkButton
                ID="btnLogout"
                runat="server"
                CssClass="logout-btn"
                OnClick="btnLogout_Click">

                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>

            </asp:LinkButton>

        </div>


        <!-- ADMIN PROFILE -->
        <a href="<%= ResolveUrl("~/Admin/AdminProfile.aspx") %>"
           class="admin-user">

            <div class="admin-icon">
                A
            </div>

            <div class="admin-info">

                <div class="admin-name">
                    Super Admin
                </div>

                <div class="admin-email">
                    admin@hirehub.com
                </div>

            </div>

        </a>

    </aside>


    <!-- MAIN -->
    <main class="main">

        <header class="topbar">

            <div class="page-title">
                Admin Dashboard
            </div>

            <div class="notification">
                <i class="bi bi-bell"></i>
            </div>

        </header>


        <section class="content">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </section>

    </main>

</form>

</body>
</html>