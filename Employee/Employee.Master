<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Employee.master.cs" Inherits="Job_Portal.Employee.Employee" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <title>HireHub - Employer</title>

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Employee CSS -->
    <link
        rel="stylesheet"
        href="<%= ResolveUrl("~/Assets/Employeecss/employee.css") %>" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <!-- ================= SIDEBAR ================= -->

    <div class="employee-sidebar">

        <!-- LOGO -->
        <div class="employee-logo">

            <img src="<%= ResolveUrl("~/Assets/images/logo.png") %>"
                 alt="HireHub Logo" />

            <span class="employee-badge">
                EMPLOYER
            </span>

        </div>


        <!-- NAVIGATION -->
        <div class="employee-menu">

            <!-- Dashboard -->
            <a href="Employee_master.aspx"
               class="employee-menu-item active">

                <i class="bi bi-grid-1x2-fill"></i>

                <span>Dashboard</span>

            </a>


            <!-- Jobs -->
            <a href="Jobs.aspx"
               class="employee-menu-item">

                <i class="bi bi-briefcase-fill"></i>

                <span>Jobs</span>

            </a>


            <!-- Applications -->
            <a href="Applications.aspx"
               class="employee-menu-item">

                <i class="bi bi-file-earmark-text-fill"></i>

                <span>Applications</span>

            </a>


            <!-- Candidates -->
            <a href="Candidates.aspx"
               class="employee-menu-item">

                <i class="bi bi-circle"></i>

                <span>Candidates</span>

            </a>


            <!-- Company Profile -->
            <a href="Company_Profile.aspx"
               class="employee-menu-item">

                <i class="bi bi-building"></i>

                <span>Company Profile</span>

            </a>

        </div>


        <!-- BOTTOM SECTION -->

        <div class="employee-bottom">

            <!-- Logout -->
            <asp:Button
                ID="btnLogout"
                runat="server"
                Text="Logout"
                CssClass="employee-logout"
                PostBackUrl="~/Users/Login.aspx" />


            <!-- COMPANY USER -->

            <div class="employee-user">

                <div class="employee-user-circle">
                    TCS
                </div>

                <div class="employee-user-info">

                    <strong>
                        Tata Consultancy S...
                    </strong>

                    <span>
                        recruitment@tcs.com
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= MAIN AREA ================= -->

    <div class="employee-main">

        <asp:ContentPlaceHolder
            ID="ContentPlaceHolder1"
            runat="server">
        </asp:ContentPlaceHolder>

    </div>

</form>

</body>
</html>
